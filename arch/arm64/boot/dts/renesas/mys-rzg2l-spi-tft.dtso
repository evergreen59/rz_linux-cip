/*
 * Optional Device Tree overlay for the MYiR Remi Pi SPI TFT add-on.
 *
 * SPI0 drives:
 *   - an ILI9341 320x240 panel on native chip-select 0;
 *   - an ADS7846 resistive touchscreen controller on GPIO chip-select 1.
 *
 * This overlay is intentionally not listed in the Renesas DTB Makefile.  Build
 * it explicitly and apply it to a symbol-enabled Remi Pi base DTB when the
 * optional display/touch hardware is fitted.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>

&pinctrl {
	spi0_tft_pins: spi0-tft {
		pinmux = <RZG2L_PORT_PINMUX(47, 0, 5)>,
			 <RZG2L_PORT_PINMUX(47, 1, 5)>,
			 <RZG2L_PORT_PINMUX(47, 2, 5)>,
			 <RZG2L_PORT_PINMUX(47, 3, 5)>;
	};
};

&spi0 {
	pinctrl-0 = <&spi0_tft_pins>;
	pinctrl-names = "default";
	num-cs = <2>;
	/* CS0: native RSPI SSL (panel); CS1: GPIO, active-low (touch). */
	cs-gpios = <0>, <&pinctrl RZG2L_GPIO(33, 0) GPIO_ACTIVE_LOW>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	display@0 {
		compatible = "adafruit,yx240qv29", "ilitek,ili9341";
		reg = <0>;
		/* ILI9341 spec maxes at 10 MHz; kept at the vendor's 48 MHz. */
		spi-max-frequency = <48000000>;
		dc-gpios = <&pinctrl RZG2L_GPIO(4, 1) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZG2L_GPIO(23, 0) GPIO_ACTIVE_HIGH>;
		rotation = <270>;
	};

	touchscreen@1 {
		compatible = "ti,ads7846";
		reg = <1>;
		spi-max-frequency = <1000000>;
		/* The driver derives the pen-down IRQ from this GPIO. */
		pendown-gpio = <&pinctrl RZG2L_GPIO(23, 1) GPIO_ACTIVE_LOW>;

		ti,x-min = /bits/ 16 <0>;
		ti,y-min = /bits/ 16 <0>;
		ti,x-max = /bits/ 16 <0x0fff>;
		ti,y-max = /bits/ 16 <0x0fff>;
		ti,pressure-min = /bits/ 16 <0>;
		ti,pressure-max = /bits/ 16 <0xffff>;
		ti,x-plate-ohms = /bits/ 16 <400>;

		touchscreen-swapped-x-y;
	};
};
